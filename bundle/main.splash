let cAmber     = #xC4762E
let cAmberDeep = #x9C5A20
let cAmberSoft = #xE8A25E

let cInk  = #x3A3028
let cInk2 = #x8A7C69
let cInk3 = #xA99A83

let cAmbInk  = #xEDE5D8
let cAmbInk2 = #x8F8375

let cLine = #xDCD1BB

// ───────────────────────── 尺寸常量 ─────────────────────────

let COL_W = 420
let PAD   = 24

// ───────────────────────── 页面定义 ─────────────────────────

